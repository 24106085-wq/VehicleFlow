# Settings for running the backend WITHOUT Docker (cd backend; copy this to .env). With Docker, use the .env in the project root instead.
PORT=5000
CLIENT_URL=http://localhost:5173
# SQLite file for local runs, relative to the backend folder (created automatically).
# Inside Docker the path is /app/data/vehicleflow.db and is set by docker-compose.yml.
DB_PATH=./data/vehicleflow.db
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret
SEED_DEMO_DATA=true
