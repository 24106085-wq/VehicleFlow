# Copy this file to ".env" (PowerShell:  Copy-Item .env.example .env) and set JWT_SECRET. Docker Compose reads ".env" automatically.
# Never commit ".env" and never share your JWT_SECRET.

# --- Backend -------------------------------------------------------------
# REQUIRED: long random text used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# and paste the result after the = sign. The backend refuses to start while this is still the example value.
JWT_SECRET=replace_with_a_secure_random_secret
PORT=5000
# Address you type in the browser (used by the backend CORS setting).
CLIENT_URL=http://localhost:8080
# true = on the very FIRST start (completely empty database) add the demo users and data.
# Never overwrites or deletes existing data. Set to false for an empty database with no demo data.
SEED_DEMO_DATA=true

# --- Database (SQLite) -----------------------------------------------------
# No database server is needed. docker-compose.yml already sets this for the backend container:
#   DB_PATH=/app/data/vehicleflow.db
# /app/data is the persistent Docker volume "vehicleflow_sqlite_data". Do not change the path.

# --- Optional: ports on your PC --------------------------------------------
# FRONTEND_PORT=8080
# BACKEND_PORT=5001   (host port for the backend; container port stays 5000)
